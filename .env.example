# Dictum secrets. Copy to %APPDATA%\Dictum\.env (preferred) or next to Dictum.exe and fill in.
# Precedence (standard dotenv): a real environment variable (process, user or machine) wins; .env only fills
# keys that are not set. Between the two .env files, the %APPDATA%\Dictum one wins; an empty KEY= fills nothing.
# Values are never written to settings.json or the log, and never shown in the windows or error messages.
# Syntax: KEY=value, optional "export ", '#' comments, "double" or 'single' quotes.

# Cloud clean-up with Anthropic (opt-in, switched on in Settings > Clean-up after a consent step; the default is
# "local"). Without a key Dictum uses the local cleanup model
# instead (logged), or the rule-based tidy if that model is not downloaded. The raw transcript is never pasted as is.
ANTHROPIC_API_KEY=

# The OpenAI preset (Settings > Clean-up). Sent to api.openai.com only. Without it nothing is sent there.
OPENAI_API_KEY=

# The Google Gemini preset. Sent to generativelanguage.googleapis.com only. Without it nothing is sent there.
GEMINI_API_KEY=

# llm.provider = "openai-compatible" at any other address (a custom server), sent when set. Optional: local servers
# such as LM Studio need no key. Never sent to the OpenAI or Google Gemini hosts (on any port) or to the Ollama preset address.
LLM_API_KEY=

# Cloud speech (speech.provider = "openai-compatible": an advanced option, off by default, that sends the recording of
# each dictation to the service you chose, only after its own consent step). OPENAI_API_KEY above also serves cloud
# speech at api.openai.com. Without the key a service needs, nothing is sent and the speech model on this PC is used.

# Sent only to an Azure OpenAI resource (a host ending .openai.azure.com). Without it nothing is sent there.
AZURE_OPENAI_API_KEY=

# Sent only to api.groq.com. Without it nothing is sent there.
GROQ_API_KEY=

# Cloud speech at any other address (a custom server), sent when set. Optional. Never sent to the OpenAI, Azure OpenAI
# or Groq hosts (on any port).
SPEECH_API_KEY=
