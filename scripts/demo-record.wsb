<!--
  Windows Sandbox configuration for scripts\demo-record.ps1, which fills the {{...}} tokens and writes the result into
  the run's folder. The same clean Windows as sandbox-check.wsb: networking, the virtual GPU, the microphone, the camera,
  the clipboard and printers off; every mapped folder read-only except the run's folder (C:\sbx\out). The driver runs
  hidden, so no console window appears in the recording.
-->
<Configuration>
  <VGpu>Disable</VGpu>
  <Networking>Disable</Networking>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <PrinterRedirection>Disable</PrinterRedirection>
  <MemoryInMB>6144</MemoryInMB>
  <MappedFolders>
{{MappedFolders}}
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -File C:\sbx\scripts\demo-inside.ps1</Command>
  </LogonCommand>
</Configuration>
