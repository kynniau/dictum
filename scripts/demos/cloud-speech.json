{
  "name": "cloud-speech",
  "title": "Cloud speech (optional)",
  "summary": "Settings > Models in the Advanced view (1.3): the Cloud speech card, the Service list (OpenAI), the key line, a placeholder model name, then Use cloud speech… shows the consent step. The demo clicks Keep speech on this PC: it never agrees, so nothing is switched on and no voice is sent.",
  "prepare": [
    { "do": "plainDesktop" },
    { "do": "installSilently" },
    { "do": "launch" },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Continue", "timeout": 120 } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Next" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Next" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Use this hotkey" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Next" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Finish", "timeout": 60 } },
    { "do": "wait", "seconds": 10 }
  ],
  "steps": [
    {
      "id": "arrow",
      "caption": "Click the little up-arrow near the clock, at the bottom right of the screen.",
      "skipIf": { "windowClass": "Shell_TrayWnd", "type": "Button", "name": "Dictum", "match": "prefix" },
      "do": [ { "do": "click", "target": { "windowClass": "Shell_TrayWnd", "type": "Button", "name": "Show Hidden Icons" } } ]
    },
    {
      "id": "tray",
      "caption": "Click the Dictum icon.",
      "do": [ { "do": "click", "target": { "type": "Button", "name": "Dictum", "match": "prefix" } } ]
    },
    {
      "id": "settings",
      "caption": "Click Settings.",
      "do": [ { "do": "click", "target": { "window": "^Dictum$", "type": "Button", "name": "Settings" } } ]
    },
    {
      "id": "models",
      "caption": "Click Models, on the left.",
      "do": [ { "do": "click", "target": { "window": "^Dictum settings$", "type": "ListItem", "name": "Models" } } ]
    },
    {
      "id": "advanced",
      "caption": "Cloud speech is set up in the Advanced view. Click Advanced.",
      "do": [ { "do": "click", "target": { "window": "^Dictum settings$", "name": "Models view: Advanced" } } ]
    },
    {
      "id": "card",
      "caption": "Find the Cloud speech card. It is optional, and it would send your voice to a service.",
      "do": [ { "do": "point", "target": { "window": "^Dictum settings$", "type": "Text", "name": "Optional, for a slow PC", "match": "prefix", "timeout": 30 } } ],
      "scrollFirst": true,
      "after": 3.5
    },
    {
      "id": "service",
      "caption": "The Service list starts with OpenAI. This demo uses it.",
      "do": [ { "do": "point", "target": { "window": "^Dictum settings$", "type": "ComboBox", "name": "Service" } } ],
      "after": 2
    },
    {
      "id": "key-line",
      "caption": "This line says the name your key needs: OPENAI_API_KEY. Without a key nothing is sent.",
      "do": [ { "do": "point", "target": { "window": "^Dictum settings$", "type": "Text", "name": "The key goes in .env", "match": "prefix" } } ],
      "after": 3
    },
    {
      "id": "model",
      "caption": "Type the model name your service gives you. This demo types a placeholder.",
      "do": [ { "do": "type", "into": { "window": "^Dictum settings$", "type": "Edit", "name": "Model" }, "text": "your-model-here" } ],
      "after": 2
    },
    {
      "id": "use",
      "caption": "Click Use cloud speech.",
      "do": [ { "do": "click", "target": { "window": "^Dictum settings$", "type": "Button", "name": "Use cloud speech", "match": "prefix" } } ],
      "after": 1.5
    },
    {
      "id": "consent",
      "caption": "Dictum says that your voice would go to the service, with a warning. Read it all.",
      "do": [ { "do": "point", "target": { "window": "^Dictum: Send your voice", "type": "Text", "name": "Send your voice to a cloud service?", "timeout": 30 } } ],
      "after": 4.5,
      "poster": true
    },
    {
      "id": "keep",
      "caption": "This demo clicks Keep speech on this PC, so your voice stays here.",
      "do": [ { "do": "invokeClick", "target": { "window": "^Dictum: Send your voice", "type": "Button", "name": "Keep speech on this PC" } } ],
      "after": 2.5
    }
  ]
}
