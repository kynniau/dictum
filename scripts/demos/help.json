{
  "name": "help",
  "title": "Find help in Dictum",
  "summary": "Settings > Help (1.2): a list of the questions it answers, each a link to its answer; how Dictum works; Send feedback opens an email in the user's own mail program (shown, not clicked: the test PC has no mail program).",
  "prepare": [
    { "do": "plainDesktop" },
    { "do": "installSilently" },
    { "do": "launch" },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Next", "timeout": 120 } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Next" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Next" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Use this hotkey" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Next" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Finish", "timeout": 60 } },
    { "do": "wait", "seconds": 10 }
  ],
  "steps": [
    {
      "id": "arrow",
      "caption": "Click the little up-arrow near the clock, at the bottom right of the screen.",
      "skipIf": { "windowClass": "Shell_TrayWnd", "type": "Button", "name": "Dictum", "match": "prefix" },
      "do": [ { "do": "click", "target": { "windowClass": "Shell_TrayWnd", "type": "Button", "name": "Show Hidden Icons" } } ]
    },
    {
      "id": "tray",
      "caption": "Click the Dictum icon.",
      "do": [ { "do": "click", "target": { "type": "Button", "name": "Dictum", "match": "prefix" } } ]
    },
    {
      "id": "settings",
      "caption": "Click Settings.",
      "do": [ { "do": "click", "target": { "window": "^Dictum$", "type": "Button", "name": "Settings" } } ]
    },
    {
      "id": "help",
      "caption": "Click Help, at the bottom of the list on the left.",
      "do": [ { "do": "click", "target": { "window": "^Dictum settings$", "type": "ListItem", "name": "Help" } } ]
    },
    {
      "id": "index",
      "caption": "Help starts with a list of the questions it answers.",
      "do": [ { "do": "point", "target": { "window": "^Dictum settings$", "type": "Text", "name": "Questions on this page", "timeout": 30 } } ],
      "after": 2.5
    },
    {
      "id": "voice",
      "caption": "Click a question, for example Where does my voice go?",
      "do": [ { "do": "click", "target": { "window": "^Dictum settings$", "type": "Button", "name": "Where does my voice go?" } } ],
      "after": 1
    },
    {
      "id": "voice-answer",
      "caption": "Help moves down to its answer.",
      "do": [
        { "do": "point", "target": { "window": "^Dictum settings$", "type": "Text", "name": "Nowhere. Dictum turns your voice", "match": "prefix" } }
      ],
      "after": 3
    },
    {
      "id": "wrong",
      "caption": "Click another question: Why did it type the wrong words?",
      "do": [ { "do": "click", "target": { "window": "^Dictum settings$", "type": "Button", "name": "Why did it type the wrong words?" } } ],
      "scrollFirst": true,
      "after": 1
    },
    {
      "id": "wrong-answer",
      "caption": "Its answer lists what to try.",
      "do": [
        {
          "do": "point",
          "target": { "window": "^Dictum settings$", "type": "Text", "name": "Keep the microphone close to your mouth", "match": "contains" }
        }
      ],
      "after": 3
    },
    {
      "id": "feedback",
      "caption": "To tell us something, use Send feedback. It opens an email you can check, then send.",
      "do": [ { "do": "point", "target": { "window": "^Dictum settings$", "type": "Button", "name": "Send feedback or suggest a feature" } } ],
      "scrollFirst": true,
      "after": 3,
      "poster": true
    }
  ]
}
