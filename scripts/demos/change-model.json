{
  "name": "change-model",
  "title": "Change the speech model",
  "summary": "Settings > Models in the Simple view (1.2): Standard is in use; choose More accurate (small.en, already on this PC: copied from the host's model folder, read-only); then Advanced shows every model by name.",
  "environment": { "extraModels": ["ggml-small.en.bin"] },
  "prepare": [
    { "do": "plainDesktop" },
    { "do": "installSilently" },
    { "do": "modelsFromHost" },
    { "do": "launch" },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Continue", "timeout": 120 } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Next" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Next" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Use this hotkey" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Next" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Finish", "timeout": 60 } },
    { "do": "wait", "seconds": 10 }
  ],
  "steps": [
    {
      "id": "arrow",
      "caption": "Click the little up-arrow near the clock, at the bottom right of the screen.",
      "skipIf": { "windowClass": "Shell_TrayWnd", "type": "Button", "name": "Dictum", "match": "prefix" },
      "do": [ { "do": "click", "target": { "windowClass": "Shell_TrayWnd", "type": "Button", "name": "Show Hidden Icons" } } ]
    },
    {
      "id": "tray",
      "caption": "Click the Dictum icon.",
      "do": [ { "do": "click", "target": { "type": "Button", "name": "Dictum", "match": "prefix" } } ]
    },
    {
      "id": "settings",
      "caption": "Click Settings.",
      "do": [ { "do": "click", "target": { "window": "^Dictum$", "type": "Button", "name": "Settings" } } ]
    },
    {
      "id": "models",
      "caption": "Click Models, on the left.",
      "do": [ { "do": "click", "target": { "window": "^Dictum settings$", "type": "ListItem", "name": "Models" } } ]
    },
    {
      "id": "standard",
      "caption": "Standard is in use. It works well for most people.",
      "do": [ { "do": "point", "target": { "window": "^Dictum settings$", "type": "Text", "name": "In use", "sameRowAs": "Standard", "timeout": 30 } } ],
      "after": 2
    },
    {
      "id": "use",
      "caption": "If words often come out wrong, click Use next to More accurate.",
      "do": [ { "do": "click", "target": { "window": "^Dictum settings$", "type": "Button", "name": "Use More accurate" } } ]
    },
    {
      "id": "in-use",
      "caption": "That's it. More accurate now says In use.",
      "do": [
        { "do": "point", "target": { "window": "^Dictum settings$", "type": "Text", "name": "In use", "sameRowAs": "More accurate", "timeout": 60 } }
      ],
      "after": 2.5,
      "poster": true
    },
    {
      "id": "advanced",
      "caption": "To see every model by its name and size, click Advanced.",
      "do": [ { "do": "click", "target": { "window": "^Dictum settings$", "name": "Models view: Advanced" } } ]
    },
    {
      "id": "names",
      "caption": "Advanced lists every model by name. small.en is in use.",
      "do": [ { "do": "point", "target": { "window": "^Dictum settings$", "type": "Text", "name": "In use", "sameRowAs": "small.en ", "timeout": 30 } } ],
      "after": 3
    }
  ]
}
