{
  "name": "cloud-cleanup",
  "title": "Turn on cloud clean-up (optional)",
  "summary": "Settings > Clean-up: choose a service, click Create the key file (1.3: Dictum makes .env with the placeholder line your-key-here, never a real key, and opens it in Notepad), save it, then Use cloud clean-up… shows the consent step with its warning. The demo agrees with the placeholder in place of a key, so the card says it is waiting for the key and nothing is sent.",
  "environment": { "notepad": true },
  "prepare": [
    { "do": "plainDesktop" },
    { "do": "installSilently" },
    { "do": "openWith", "extension": ".env", "path": "C:\\sbx\\notepad\\notepad.exe" },
    { "do": "launch" },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Next", "timeout": 120 } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Next" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Next" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Use this hotkey" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Next" } },
    { "do": "wait", "seconds": 1.5 },
    { "do": "click", "target": { "window": "^Welcome to Dictum$", "type": "Button", "name": "Finish", "timeout": 60 } },
    { "do": "wait", "seconds": 10 }
  ],
  "steps": [
    {
      "id": "arrow",
      "caption": "Click the little up-arrow near the clock, at the bottom right of the screen.",
      "skipIf": { "windowClass": "Shell_TrayWnd", "type": "Button", "name": "Dictum", "match": "prefix" },
      "do": [ { "do": "click", "target": { "windowClass": "Shell_TrayWnd", "type": "Button", "name": "Show Hidden Icons" } } ]
    },
    {
      "id": "tray",
      "caption": "Click the Dictum icon.",
      "do": [ { "do": "click", "target": { "type": "Button", "name": "Dictum", "match": "prefix" } } ]
    },
    {
      "id": "settings",
      "caption": "Click Settings.",
      "do": [ { "do": "click", "target": { "window": "^Dictum$", "type": "Button", "name": "Settings" } } ]
    },
    {
      "id": "cleanup",
      "caption": "Click Clean-up, on the left.",
      "do": [ { "do": "click", "target": { "window": "^Dictum settings$", "type": "ListItem", "name": "Clean-up" } } ]
    },
    {
      "id": "service",
      "caption": "Under Cloud clean-up, open the Service list.",
      "do": [ { "do": "click", "target": { "window": "^Dictum settings$", "type": "ComboBox", "name": "Service" } } ],
      "scrollFirst": true,
      "after": 1
    },
    {
      "id": "anthropic",
      "caption": "Choose your service. This demo chooses Anthropic.",
      "do": [ { "do": "click", "target": { "type": "ListItem", "name": "Anthropic (Claude)" } } ]
    },
    {
      "id": "key-line",
      "caption": "This line says the name your key needs: ANTHROPIC_API_KEY.",
      "do": [ { "do": "point", "target": { "window": "^Dictum settings$", "type": "Text", "name": "The key goes in .env", "match": "prefix" } } ],
      "after": 2.5
    },
    {
      "id": "create-key-file",
      "caption": "Click Create the key file. Dictum makes it for you and opens it.",
      "do": [ { "do": "click", "target": { "window": "^Dictum settings$", "type": "Button", "name": "Create the key file", "match": "prefix" } } ],
      "after": 2.5
    },
    {
      "id": "notepad",
      "caption": "The key file opens in Notepad. Put your own key in place of your-key-here.",
      "do": [ { "do": "point", "target": { "window": "^\\.env - Notepad$", "name": "Text editor", "timeout": 30 } } ],
      "after": 3
    },
    {
      "id": "save",
      "caption": "After you add your key, press Ctrl+S to save. This demo keeps the placeholder.",
      "do": [ { "do": "key", "keys": "Ctrl+S" } ],
      "after": 2
    },
    {
      "id": "close-notepad",
      "caption": "Close Notepad.",
      "do": [ { "do": "click", "target": { "window": "^\\.env - Notepad$", "type": "Button", "name": "Close" } } ],
      "after": 1.5
    },
    {
      "id": "use",
      "caption": "Click Use cloud clean-up.",
      "do": [ { "do": "click", "target": { "window": "^Dictum settings$", "type": "Button", "name": "Use cloud clean-up", "match": "prefix" } } ],
      "after": 1.5
    },
    {
      "id": "consent",
      "caption": "Dictum says what it will send, and to whom, with a warning. Read it all.",
      "do": [ { "do": "point", "target": { "window": "^Dictum: Send dictations", "type": "Text", "name": "Send dictations to a cloud service?", "timeout": 30 } } ],
      "after": 4,
      "poster": true
    },
    {
      "id": "allow",
      "caption": "Click Allow cloud clean-up only if you agree. This demo agrees, with no real key.",
      "do": [ { "do": "invokeClick", "target": { "window": "^Dictum: Send dictations", "type": "Button", "name": "Allow cloud clean-up" } } ],
      "after": 2.5
    },
    {
      "id": "state",
      "caption": "There is no real key yet, so the card says it is waiting for it. Nothing is sent.",
      "do": [ { "do": "point", "target": { "window": "^Dictum settings$", "type": "Text", "name": "On, but waiting for your", "match": "prefix", "timeout": 30 } } ],
      "scrollFirst": true,
      "after": 4
    }
  ]
}
