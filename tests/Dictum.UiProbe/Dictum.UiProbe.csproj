<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shows Dictum's overlays on the real Win32 backend and reports, line by line, whether any of them took the foreground
       or caught a click (SPEC §7), and, given the dialog-capture argument, that a question opened by a click gets the mouse (SPEC §32). Run by PillFocusTests and DialogOwnerTests in its own process: a process can host one Avalonia platform,
       and the test process hosts the headless one. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <RootNamespace>Dictum.UiProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Dictum.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dictum.UI\Dictum.UI.csproj" />
    <ProjectReference Include="..\..\src\Dictum.Windows\Dictum.Windows.csproj" />
  </ItemGroup>

</Project>
