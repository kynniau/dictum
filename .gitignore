# build output
bin/
obj/
dist/
*.user
.vs/

# packaging: generated by scripts/package-msix.ps1, scripts/build-installer.ps1 and scripts/make-test-cert.ps1
packaging/out/
packaging/AppxManifest.xml
packaging/test-cert/
*.msix
*.msixbundle
*.msixupload

# secrets and local state
.env
*.env
*.pfx
*.p12
*.pfx-password.txt

# models are large; they live in %LOCALAPPDATA%\Dictum\models (whisper .bin, clean-up .gguf, partial downloads)
models/
*.bin
*.gguf
*.part

# test artefacts
TestResults/
*.trx

# Private material never leaves this PC (public repo)
# Recordings, transcripts and personal test material live outside the repository. The hooks in .githooks refuse the
# same things (case-insensitively), and the CI job "private-material" looks for them after the fact.
private/
recordings/
transcripts/
*.wav
!tests/fixtures/*.wav
*.mp4
*.m4a
*.mp3
*.ogg
*.oga
*.opus
*.flac
*.aac
*.wma
*.webm
*.3gp
*.amr
*.mov
*.mkv
*.avi
*.aiff
*.caf

# local scratch copies and backups
scratch/
.scratch/
*.bak
*.orig
