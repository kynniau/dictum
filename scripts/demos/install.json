{
  "name": "install",
  "title": "Install Dictum",
  "summary": "From the downloaded Setup file to Dictum's welcome window (1.2: the six-step welcome replaces the first-run dialogs). The Setup copy is marked as downloaded from the internet (Zone.Identifier), as a browser leaves it.",
  "prepare": [
    { "do": "plainDesktop" },
    { "do": "copyDownloaded", "from": "{setup}", "to": "%USERPROFILE%\\Downloads" },
    { "do": "openFolder", "path": "%USERPROFILE%\\Downloads" },
    { "do": "waitFor", "target": { "window": "^Downloads", "type": "ListItem", "name": "Dictum-Setup", "match": "prefix", "timeout": 30 } }
  ],
  "steps": [
    {
      "id": "open",
      "caption": "Double-click Dictum-Setup in your Downloads folder.",
      "do": [
        { "do": "doubleClick", "target": { "window": "^Downloads", "type": "ListItem", "name": "Dictum-Setup", "match": "prefix" } },
        {
          "do": "waitFor",
          "optional": true,
          "target": { "windowClass": "ApplicationFrameWindow", "type": "Button", "name": "^(More info|Run|Don't run)$", "match": "regex", "timeout": 12 }
        }
      ]
    },
    {
      "id": "smartscreen-more",
      "caption": "If Windows says it protected your PC, click More info.",
      "optional": true,
      "do": [ { "do": "click", "target": { "windowClass": "ApplicationFrameWindow", "name": "More info", "timeout": 1 } } ]
    },
    {
      "id": "smartscreen-run-anyway",
      "caption": "Then click Run anyway.",
      "optional": true,
      "do": [ { "do": "click", "target": { "windowClass": "ApplicationFrameWindow", "type": "Button", "name": "Run anyway", "timeout": 3 } } ]
    },
    {
      "id": "smartscreen-offline",
      "caption": "If Windows says SmartScreen can't be reached, click Run.",
      "optional": true,
      "do": [ { "do": "click", "target": { "windowClass": "ApplicationFrameWindow", "type": "Button", "name": "Run", "timeout": 1 } } ]
    },
    {
      "id": "licence",
      "caption": "Setup shows Dictum's Terms of Use. Choose I accept the agreement, then click Next.",
      "do": [
        { "do": "click", "target": { "window": "^Setup", "type": "RadioButton", "name": "I accept the agreement", "timeout": 60 } },
        { "do": "click", "target": { "window": "^Setup", "type": "Button", "name": "Next", "match": "prefix" } }
      ]
    },
    {
      "id": "next",
      "caption": "Setup moves on. Click Next.",
      "do": [ { "do": "click", "target": { "window": "^Setup", "type": "Button", "name": "Next", "match": "prefix", "timeout": 60 } } ]
    },
    {
      "id": "install",
      "caption": "Click Install.",
      "do": [ { "do": "click", "target": { "window": "^Setup", "type": "Button", "name": "Install" } } ]
    },
    {
      "id": "launch",
      "caption": "When it has finished, leave Launch Dictum ticked.",
      "do": [ { "do": "point", "target": { "window": "^Setup", "type": "ListItem", "name": "Launch Dictum", "timeout": 180 } } ]
    },
    {
      "id": "finish",
      "caption": "Click Finish.",
      "do": [ { "do": "click", "target": { "window": "^Setup", "type": "Button", "name": "Finish" } } ]
    },
    {
      "id": "started",
      "caption": "Dictum starts and welcomes you. A few short steps set it up.",
      "do": [ { "do": "point", "target": { "window": "^Welcome to Dictum$", "type": "Text", "name": "How Dictum works", "timeout": 90 } } ],
      "poster": true,
      "after": 3
    }
  ]
}
